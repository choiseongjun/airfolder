{
  "expo": {
    "name": "Memonestia",
    "slug": "snaproom",
    "version": "1.0.0",
    "scheme": "snaproom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.choisj2702.snaproom",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.choisj2702.snaproom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7f5ee"
      },
      "versionCode": 3
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "expo-background-task",
      [
        "expo-media-library",
        {
          "photosPermission": "Find photos and videos from your chosen dates. Only selected files are uploaded.",
          "savePhotosPermission": "Save photos you choose to your library.",
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose original photos and videos to add to your Memonestia space.",
          "cameraPermission": "Take a photo to add to your folder.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "video/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*"
            ]
          }
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "656c1ca2-14c7-46b5-b528-089bcf4a5592"
      }
    },
    "owner": "seongjunchoi"
  }
}
