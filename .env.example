DATABASE_URL=postgresql://SERVER_ONLY_CONNECTION
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=SERVER_ONLY_SECRET
SUPABASE_STORAGE_BUCKET=snaproom-photos

# Dedicated Snaproom Firebase project only. Leave empty until provisioned.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after Google and Apple providers and authorized domains are configured.
NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false
# Verified public HTTPS origin. Set before the production build to enable indexing.
SITE_URL=
# Public support contact, confirmed by the service operator.
SUPPORT_EMAIL=
# Enable only after APNs/FCM credentials and delivery have been verified.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# Server-only JSON for processing requested Firebase account deletions.
FIREBASE_SERVICE_ACCOUNT_JSON=
# At least 32 random characters; protects the daily account-deletion job on Vercel.
CRON_SECRET=

# Server-side, allowlisted product events only. Local/preview stays development.
ANALYTICS_ENVIRONMENT=development
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional Firebase Analytics: same web app, enabled only after per-browser opt-in.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
